/* Import built-in modules */
IMPORT(BUILTIN(FILESTAT))
IMPORT(BUILTIN(BUILDCACHE))

USING(FILESTAT, *)
USING(BUILDCACHE, *)

/* Declare executables */
DECLARE(EXECUTABLE, gcc, "GNU C++ Compiler", "SYSTEM", NULL)
DECLARE(EXECUTABLE, mkdir, "Create directories", "SYSTEM", NULL)

/* Declare build flags */
DECLARE(FLAGS, SDL3_INCLUDE, "-I$1")
DECLARE(FLAGS, SDL3_LIB, "-L$1 -l$2")
DECLARE(FLAGS, COMPILE_FLAGS, "-Wall -std=c++17 -c $1 -o $2")
DECLARE(FLAGS, LINK_FLAGS, "$1 $2 -o $3")

/* Declare variables */
DECLARE(VARIABLE, SDL3_INCLUDE_PATH, "libs/sdl3-vendor/include")
DECLARE(VARIABLE, SDL3_LIB_PATH, "libs/sdl3-vendor/lib")
DECLARE(VARIABLE, MAIN_SRC, "main.cpp")
DECLARE(VARIABLE, SHAPES_SRC, "src/shapes.cpp")
DECLARE(VARIABLE, SHAPES_HDR, "src/shapes.hpp")
DECLARE(VARIABLE, MAIN_OBJ, "build/main.o")
DECLARE(VARIABLE, SHAPES_OBJ, "build/shapes.o")
DECLARE(VARIABLE, TARGET_EXE, "build/sdl3_app")
DECLARE(VARIABLE, BUILD_DIR, "build")

/* Enable build cache writing */
WRITEBUILDCACHE()

/* Create build directory if needed */
IF(NOT(EXISTS(@BUILD_DIR)),
    EXECUTE(mkdir, "-p", BUILD_DIR),
    ECHO(@"Build directory '$BUILD_DIR' already exists.")
)

/* Build main.o if needed */
ECHO("Checking main.o dependencies...")
IFANY(
    NOT(EXISTS(MAIN_OBJ)),
    NEQ(@STAT(MAIN_SRC).LASTMODIFIEDDATE, @CACHE(MAIN_SRC).LASTMODIFIEDDATE),
    NEQ(@STAT(SHAPES_HDR).LASTMODIFIEDDATE, @CACHE(SHAPES_HDR).LASTMODIFIEDDATE),
    ECHO(@"Rebuilding main.o from '$MAIN_SRC'"),
    EXECUTE(gcc,
            SDL3_INCLUDE_PATH(SDL3_INCLUDE),
            MAIN_SRC,
            MAIN_OBJ,
            @COMPILE_FLAGS)
)

/* Build shapes.o if needed */
ECHO("Checking shapes.o dependencies...")
IFANY(
    NOT(EXISTS(@SHAPES_OBJ)),
    NEQ(@STAT(SHAPES_SRC).LASTMODIFIEDDATE, @CACHE(SHAPES_SRC).LASTMODIFIEDDATE),
    NEQ(@STAT(SHAPES_HDR).LASTMODIFIEDDATE, @CACHE(SHAPES_HDR).LASTMODIFIEDDATE),
    ECHO(@"Rebuilding shapes.o from '$SHAPES_SRC'"),
    EXECUTE(gcc,
            "-Wall", "-std=c++17",
            SDL3_INCLUDE_PATH(SDL3_INCLUDE),
            "-c", SHAPES_SRC,
            "-o", SHAPES_OBJ)
)

/* Link final executable if needed */
ECHO("Checking final executable dependencies...")
IFANY(
    NOT(EXISTS(TARGET_EXE)),
    NEQ(@STAT(MAIN_OBJ).LASTMODIFIEDDATE, @CACHE(MAIN_OBJ).LASTMODIFIEDDATE),
    NEQ(@STAT(SHAPES_OBJ).LASTMODIFIEDDATE, @CACHE(SHAPES_OBJ).LASTMODIFIEDDATE),
    ECHO("Linking final executable to '@TARGET_EXE'"),
    EXECUTE(gcc,
            MAIN_OBJ, SHAPES_OBJ,
            SDL3_LIB(SDL3_LIB_PATH, "SDL3"),
            "-o", TARGET_EXE)
)

/* Demonstration of new FOR Loop syntax */
ECHO("Demonstrating FOR loop:")
FOR(i, ARRAY(1, 2, 3), ECHO(i))
FOR(j, [4, 5, 6], ECHO(j))

ECHO("Build process complete.")
