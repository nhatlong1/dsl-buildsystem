IMPORT(BUILTIN(FILESTAT))
IMPORT(BUILTIN(BUILDCACHE))

USING(FILESTAT, *)
USING(BUILDCACHE, *)

WRITEBUILDCACHE()

/*
 WRITEBUILDCACHE()
 STAT(file)
 0. Create cache if it does not exist
 This adds -> 1. write or update record of the file in the cache
 2. return the record of the file
*/

DECLARE(EXECUTABLE, gpp, "GNU C++ Compiler", "winlibs.com", NULL)

IF(
	NEQ(
		SELECT(STAT("main.cpp", LASTMODIFIEDDATE)),
		SELECT(CACHE("main.cpp", LASTMODIFIEDDATE))
	),
	EXECUTE(gpp, "main.cpp", "-o", "main"),
	ECHO("main.cpp up to date")
)
