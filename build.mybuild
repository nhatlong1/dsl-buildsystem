# build.mybuild
# This script uses the DSL to build the C++ project (Self-hosting test)

# Declare toolchain
DECLARE(EXECUTABLE, gpp, "GNU C++ Compiler", "System", "g++")
DECLARE(FLAGS, cxx_flags, "-std=c++17 -Iinclude -fPIC")
DECLARE(FLAGS, link_flags, "-rdynamic -ldl") # Default Linux
DECLARE(FLAGS, output_flag, "-o $1")
DECLARE(FLAGS, shared_flag, "-shared -o $1")

# Platform detection via PLATFORM() constant function
# PLATFORM()              -> "windows" | "linux" | "macos"
# PLATFORM("arch")        -> "x86_64" | "arm64" | ...
# PLATFORM("shared_ext")  -> "dll" | "so" | "dylib"
# PLATFORM("exe_ext")     -> ".exe" | ""
# PLATFORM("is_windows")  -> TRUE | FALSE

DECLARE(VARIABLE, ext, PLATFORM("shared_ext"))

# Platform specifics
IF(PLATFORM("is_windows"),
    SET(link_flags, "")
)

# Declare Variables
DECLARE(VARIABLE, include_dir, "include")
DECLARE(VARIABLE, out_dir, "bin_self_host")
DECLARE(VARIABLE, exe_name, @"$out_dir/builder")

DECLARE(VARIABLE, loop_src, "plugins/loop.cpp")
DECLARE(VARIABLE, loop_out, @"$out_dir/plugins/loop.$ext")
DECLARE(VARIABLE, arrays_src, "plugins/arrays.cpp")
DECLARE(VARIABLE, arrays_out, @"$out_dir/plugins/arrays.$ext")
DECLARE(VARIABLE, repeat_src, "plugins/repeat.cpp")
DECLARE(VARIABLE, repeat_out, @"$out_dir/plugins/repeat.$ext")
DECLARE(VARIABLE, stat_src, "modules/filestat.cpp")
DECLARE(VARIABLE, stat_out, @"$out_dir/modules/filestat.$ext")
DECLARE(VARIABLE, cache_src, "modules/buildcache.cpp")
DECLARE(VARIABLE, cache_out, @"$out_dir/modules/buildcache.$ext")

# Ensure output directory exists
DECLARE(EXECUTABLE, mkdir, "Make Directory", "System", "mkdir")
EXECUTE(mkdir, @"$out_dir/plugins")
EXECUTE(mkdir, @"$out_dir/modules")

# Build Core
ECHO("Building Core...")
EXECUTE(
    @gpp,
    @cxx_flags,
    @link_flags,
    "src/lexer.cpp",
    "src/parser.cpp",
    "src/interpreter.cpp",
    "src/plugin_loader.cpp",
    "src/main.cpp",
    @output_flag(@exe_name)
)

# Load Loop Plugin to use FOR loop in the build script itself!
# We can just build it now.

ECHO("Building Loop Plugin...")

# Build Loop Plugin
EXECUTE(@gpp, @cxx_flags, @shared_flag(@loop_out), @loop_src)

# Load the plugin we just built
LOAD_PLUGIN(@loop_out)

# The Array syntax [ ... ] requires arrays plugin
# Build arrays plugin first using raw execute.

ECHO("Building Array Plugin...")

EXECUTE(@gpp, @cxx_flags, @shared_flag(@arrays_out), @arrays_src)
LOAD_PLUGIN(@arrays_out)

DECLARE(VARIABLE, plugins_to_build,
    [
        [@repeat_src, @repeat_out],
        [@stat_src, @stat_out],
        [@cache_src, @cache_out]
    ]
)

# Now we can use Arrays
# If implemented correctly, it will build the rest of the plugins.

ECHO("Building remaining plugins using FOR loop...")

FOR(item, @plugins_to_build,
    EXECUTE(@gpp, @cxx_flags, @shared_flag(@item[1]), @item[0])
)

ECHO("Self-hosted build complete.")
