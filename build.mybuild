# build.mybuild
# This script uses the DSL to build the C++ project (Self-hosting test)

# Declare toolchain
DECLARE(EXECUTABLE, gpp, "GNU C++ Compiler", "System", "g++")
DECLARE(FLAGS, cxx_flags, "-std=c++17 -Iinclude -Ivendor -Wall -Wextra -fPIC") # Added -Ivendor
DECLARE(FLAGS, link_flags, "-rdynamic -ldl") # Default Linux
DECLARE(FLAGS, output_flag, "-o $1")
DECLARE(FLAGS, shared_flag, "-shared -o $1")

# Platform specifics
DECLARE(VARIABLE, ext, "so")

IF(EQ(@OS, "windows"),
    SET(link_flags, "")
)
IF(EQ(@OS, "windows"),
    SET(ext, "dll")
)

# Declare Variables
DECLARE(VARIABLE, include_dir, "include")
DECLARE(VARIABLE, out_dir, "bin_self_host")
DECLARE(VARIABLE, exe_name, @"$out_dir/builder")

# Use NATIVEPATH to handle path separators
DECLARE(VARIABLE, plugins_dir, NATIVEPATH(@"$out_dir/plugins"))
DECLARE(VARIABLE, modules_dir, NATIVEPATH(@"$out_dir/modules"))

DECLARE(VARIABLE, loop_src, "plugins/loop.cpp")
DECLARE(VARIABLE, loop_out, @"$plugins_dir/loop.$ext")
DECLARE(VARIABLE, arrays_src, "plugins/arrays.cpp")
DECLARE(VARIABLE, arrays_out, @"$plugins_dir/arrays.$ext")
DECLARE(VARIABLE, repeat_src, "plugins/repeat.cpp")
DECLARE(VARIABLE, repeat_out, @"$plugins_dir/repeat.$ext")
DECLARE(VARIABLE, stat_src, "modules/filestat.cpp")
DECLARE(VARIABLE, stat_out, @"$modules_dir/filestat.$ext")
DECLARE(VARIABLE, cache_src, "modules/buildcache.cpp")
DECLARE(VARIABLE, cache_out, @"$modules_dir/buildcache.$ext")

# Ensure output directory exists. Split mkdir to avoid tree creation issues on Windows if any.
DECLARE(EXECUTABLE, mkdir, "Make Directory", "System", "mkdir")
EXECUTE(mkdir, NATIVEPATH(@out_dir))
EXECUTE(mkdir, @plugins_dir)
EXECUTE(mkdir, @modules_dir)

# Build Core
ECHO("Building Core...")
EXECUTE(
    @gpp,
    @cxx_flags,
    @link_flags,
    "src/lexer.cpp",
    "src/parser.cpp",
    "src/interpreter.cpp",
    "src/plugin_loader.cpp",
    "src/main.cpp",
    @output_flag(@exe_name)
)

ECHO("Building Plugins...")

# Build Loop Plugin first
EXECUTE(@gpp, @cxx_flags, @shared_flag(@loop_out), @loop_src)

# Load the plugin we just built
LOAD_PLUGIN(@loop_out)

# Build Arrays Plugin
EXECUTE(@gpp, @cxx_flags, @shared_flag(@arrays_out), @arrays_src)
LOAD_PLUGIN(@arrays_out)

# Build BuildCache and FileStat Plugins
EXECUTE(@gpp, @cxx_flags, @shared_flag(@cache_out), @cache_src)
EXECUTE(@gpp, @cxx_flags, @shared_flag(@stat_out), @stat_src)

LOAD_PLUGIN(@cache_out)
LOAD_PLUGIN(@stat_out)

DECLARE(VARIABLE, plugins_to_build,
    [
        [@repeat_src, @repeat_out]
    ]
)

ECHO("Building remaining plugins using FOR loop and checking cache...")

FOR(item, @plugins_to_build,
    IF(LT(SELECT(CACHE(@item[0]), "LASTMODIFIEDDATE"), SELECT(STAT(@item[0]), "LASTMODIFIEDDATE")),
        EXECUTE(@gpp, @cxx_flags, @shared_flag(@item[1]), @item[0])
    )
    IF(LT(SELECT(CACHE(@item[0]), "LASTMODIFIEDDATE"), SELECT(STAT(@item[0]), "LASTMODIFIEDDATE")),
        ECHO(@"Updated plugin: $item[0]")
    )
    UPDATE(@item[0])
)

WRITEBUILDCACHE()

ECHO("Self-hosted build complete.")
